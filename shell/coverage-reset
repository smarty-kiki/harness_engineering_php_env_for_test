#!/bin/sh

# 清零黑盒覆盖率：删除所有已落盘的采集事件。
# 长驻进程下一次 flush 会重新创建文件，因此重置后继续测试即可从头累计。

DIR="${HARNESS_COVERAGE_DIR:-/var/log/harness-coverage}"

mkdir -p "$DIR"
chmod 0777 "$DIR" 2>/dev/null || true

count=$(find "$DIR" -maxdepth 1 -type f -name '*.ndjson' 2>/dev/null | wc -l | tr -d ' ')

find "$DIR" -maxdepth 1 -type f -name '*.ndjson' -delete 2>/dev/null || true

# 前端覆盖率原始数据（cda server 写入），与 PHP 事件一起清零
FRONTEND_DIR="$DIR/frontend"
frontend_count=$(find "$FRONTEND_DIR" -maxdepth 1 -type f -name '*.json' 2>/dev/null | wc -l | tr -d ' ')

find "$FRONTEND_DIR" -maxdepth 1 -type f -name '*.json' -delete 2>/dev/null || true

echo "覆盖率已重置：清除 ${count} 个 PHP 采集文件、${frontend_count} 个前端采集文件"
