#!/bin/sh

# 清零黑盒覆盖率：删除所有已落盘的采集事件。
# 长驻进程下一次 flush 会重新创建文件，因此重置后继续测试即可从头累计。

DIR="${HARNESS_COVERAGE_DIR:-/var/log/harness-coverage}"

mkdir -p "$DIR"
chmod 0777 "$DIR" 2>/dev/null || true

count=$(find "$DIR" -maxdepth 1 -type f -name '*.ndjson' 2>/dev/null | wc -l | tr -d ' ')

find "$DIR" -maxdepth 1 -type f -name '*.ndjson' -delete 2>/dev/null || true

# 前端覆盖率按 Playwright 运行自包含在 playwright/runs/<id>/ 下，不参与累计，
# 重置 PHP 覆盖率时不删除已经生成的 trace/录像/报告，避免误删要回看的产物。
echo "覆盖率已重置：清除 ${count} 个 PHP 采集文件（前端覆盖率按 Playwright 运行单独统计）"
